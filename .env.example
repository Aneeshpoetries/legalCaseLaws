# ============================================================
# MK Professional Legal Bulletin – Environment Variables
# ============================================================

# Supabase Project URL (from your Supabase dashboard > Project Settings > API)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Service Role Key (secret – never expose to the browser)
# Found in: Supabase Dashboard > Project Settings > API > Service Role Key
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gemini API Key (for AI legal research generation)
GEMINI_API_KEY="your-gemini-api-key"

# App URL (used for self-referential links and OAuth callbacks)
APP_URL="http://localhost:3000"

# Server port (optional, defaults to 3000)
# PORT=3000
